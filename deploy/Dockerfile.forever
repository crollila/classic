# Build with repository workspace as context (classic/ and shared/ together).
FROM golang:1.23.4-bookworm AS go
FROM node:22-bookworm AS build
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.6
WORKDIR /workspace/classic
COPY classic/package*.json ./
RUN npm ci
COPY classic/ ./
COPY shared/ /workspace/shared/
RUN npm run build:forever && npm run test:forever

FROM nginx:stable-alpine
COPY classic/deploy/forever.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/classic/dist/forever-sim /usr/share/nginx/html/forever-sim
EXPOSE 8080
